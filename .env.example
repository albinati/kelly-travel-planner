# RapidAPI (Google Flights–style cash + macro price graph) — https://rapidapi.com
RAPIDAPI_KEY=

# Optional: force cash backend when both keys exist: rapidapi | serpapi
# KELLY_CASH_BACKEND=rapidapi

# Optional overrides per RapidAPI listing (defaults suit google-flights-data)
# RAPIDAPI_GOOGLE_FLIGHTS_HOST=google-flights-data.p.rapidapi.com
# RAPIDAPI_GOOGLE_FLIGHTS_BASE=https://google-flights-data.p.rapidapi.com
# RAPIDAPI_GOOGLE_FLIGHTS_CALENDAR_PATH=/flights/get-cheapest-flights-by-month
# RAPIDAPI_KIWI_HOST=
# RAPIDAPI_BOOKING_HOST=
# RAPIDAPI_TRIPADVISOR_HOST=

# SerpApi (legacy Google Flights cash) — https://serpapi.com — used when KELLY_CASH_BACKEND=serpapi
SERPAPI_API_KEY=

# Seats.aero Partner API — https://seats.aero/settings
SEATS_AERO_API_KEY=

# Project root for .env resolution (optional; else inferred from pyproject.toml)
# KELLY_PROJECT_ROOT=

# Markdown config path (default: config/kelly.md)
KELLY_CONFIG_PATH=config/kelly.md

# SQLite history directory (default: data/)
KELLY_DATA_DIR=data

# Optional: travel-hacking-toolkit data/*.json (else vendor/travel-hacking-toolkit/data if present)
# TRAVEL_HACKING_TOOLKIT_DATA=vendor/travel-hacking-toolkit/data
