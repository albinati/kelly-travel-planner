# Kelly runs out of the box — no API keys are required.
#   * Airbnb: hits Airbnb's internal staysSearch GraphQL via pyairbnb.
#   * Eurostar: scraped via patchright (stealth Playwright fork). Run
#     `patchright install chromium` once locally, or build the Docker image
#     with INSTALL_BROWSERS=true.

# Optional overrides (paths are resolved against the project root):

# Project root for .env resolution (default: walks up from kelly.settings to find pyproject.toml)
# KELLY_PROJECT_ROOT=

# Markdown config path (default: config/kelly.md)
# KELLY_CONFIG_PATH=config/kelly.md

# SQLite history directory (default: data/)
# KELLY_DATA_DIR=data
