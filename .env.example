# Kelly providers:
#   * Airbnb: hits Airbnb's internal staysSearch GraphQL via pyairbnb. No key.
#   * Eurostar: scraped via patchright (stealth Playwright fork). Run
#     `patchright install chromium` once locally, or build the Docker image
#     with INSTALL_BROWSERS=true.
#   * Hotels: LiteAPI (Nuitée). Sign up at https://dashboard.liteapi.travel —
#     the sandbox key prefix is `sand_`, production is `prod_`. Sandbox bookings
#     use the dummy `ACC_CREDIT_CARD` payment method and never charge real cards.

# LiteAPI (optional — leave blank to skip hotel shortlist; Airbnb still runs)
# LITEAPI_API_KEY=sand_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# LITEAPI_BASE_URL=https://api.liteapi.travel/v3.0

# seats.aero (optional — enables BA award-flight / Avios search). Indexes
# oneworld partner award space; Kelly uses it as an availability radar only and
# prices Avios from BA's Reward Flight Saver chart (the partner mileage in the
# response is NOT the Avios price). Get a Partner API key at https://seats.aero.
# SEATSAERO_API_KEY=
# SEATSAERO_BASE_URL=https://seats.aero/partnerapi

# SerpApi (optional — enables CASH flight search via Google Flights). Broad
# coverage incl. low-cost carriers; Kelly uses it as a paid-fare radar only
# (one-way per call — the agent searches out + back and sums). Get a key at
# https://serpapi.com. Without it, kelly_cash_flight_search returns a clean error.
# SERPAPI_API_KEY=
# SERPAPI_BASE_URL=https://serpapi.com/search.json

# Splitwise (optional — enables logging trip expenses to a shared group).
# Self-issue a personal Bearer token at https://secure.splitwise.com/apps:
#   Register an app → "Generate API key for your own account" → copy here.
# SPLITWISE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Splitwise group target for kelly_log_expense / kelly_expense_balances.
# Look up the numeric id in the Splitwise URL when viewing the group.
# KELLY_TRIP_PREFIX is prepended to every expense description for filtering.
# KELLY_SPLITWISE_GROUP_ID=
# KELLY_SPLITWISE_GROUP_NAME=
# KELLY_TRIP_PREFIX=

# Optional overrides (paths are resolved against the project root):

# Project root for .env resolution (default: walks up from kelly.settings to find pyproject.toml)
# KELLY_PROJECT_ROOT=

# Markdown config path (default: config/kelly.md)
# KELLY_CONFIG_PATH=config/kelly.md

# SQLite history directory (default: data/)
# KELLY_DATA_DIR=data
